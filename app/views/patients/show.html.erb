<h1><%= @patient.name %></h1><p class="small"><%= @patient.reference %> · Clinician: <%= @patient.clinician.name %></p>
<div class="card"><h2>Care pathway</h2><div class="timeline"><% stages=Patient.stages.keys; current=stages.index(@patient.stage); stages.each_with_index do |s,i| %><span class="stage <%= 'done' if i < current %> <%= 'current' if i == current %>"><%= i < current ? '✓ ' : '' %><%= s.titleize %></span><% end %></div><p><strong>Next action:</strong> <%= @patient.next_action %> <%= "— #{@patient.next_action_on.to_fs(:long)}" if @patient.next_action_on %></p></div>
<div class="grid"><div class="card"><h2>Outcome history</h2><% @patient.outcomes.order(:recorded_on).each do |o| %><p><strong><%= o.label %></strong> — <%= o.score %> <span class="small">(<%= o.recorded_on %>)</span></p><% end %></div><div class="card"><h2>Update pathway</h2><%= form_with url: patient_care_transitions_path(@patient) do |f| %><%= f.label :to_stage, "Move to" %><%= f.select :to_stage, Patient.stages.keys.map{|s| [s.titleize,s]} %><%= f.label :reason %><%= f.text_area :reason, required:true, placeholder:"Reason for transition" %><%= f.submit "Update pathway", class:"button" %><% end %></div></div>
<div class="card"><h2>Audit history</h2><table><thead><tr><th>When</th><th>Change</th><th>Clinician</th><th>Reason</th></tr></thead><tbody><% @patient.care_transitions.order(created_at: :desc).each do |t| %><tr><td><%= t.created_at.to_fs(:short) %></td><td><%= t.from_stage.titleize %> → <%= t.to_stage.titleize %></td><td><%= t.clinician.name %></td><td><%= t.reason %></td></tr><% end %></tbody></table></div>
