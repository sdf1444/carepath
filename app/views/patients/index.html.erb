<h1>Patients</h1><div class="card"><%= form_with url: patients_path, method: :get do |f| %><div class="grid"><div><%= f.label :q, "Search" %><%= f.text_field :q, value: params[:q], placeholder:"Name or reference" %></div><div><%= f.label :stage %><%= f.select :stage, Patient.stages.keys.map{|s| [s.titleize,s]}, {include_blank:"All stages", selected:params[:stage]} %></div></div><%= f.submit "Filter", class:"button" %><% end %></div>
<div class="card"><table><% @patients.each do |p| %><tr><td><%= link_to p.name, patient_path(p) %></td><td><%= p.reference %></td><td><span class="badge"><%= p.stage.titleize %></span></td><td><%= p.next_action %></td></tr><% end %></table></div>
