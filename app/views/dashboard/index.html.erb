<h1>Clinician caseload</h1><p class="small">Synthetic demonstration data only.</p>
<div class="grid"><div class="card"><div class="small">My caseload</div><div class="metric"><%= @patients.count %></div></div><div class="card"><div class="small">Needs attention</div><div class="metric"><%= @patients.needs_attention.count %></div></div><% %w[assessment treatment review].each do |stage| %><div class="card"><div class="small"><%= stage.titleize %></div><div class="metric"><%= @patients.where(stage: stage).count %></div></div><% end %></div>
<div class="card"><h2>Patients</h2><table><thead><tr><th>Patient</th><th>Stage</th><th>Next action</th><th>Date</th></tr></thead><tbody><% @patients.each do |p| %><tr><td><%= link_to p.name, patient_path(p) %><br><span class="small"><%= p.reference %></span></td><td><span class="badge"><%= p.stage.titleize %></span></td><td><%= p.next_action %></td><td><%= p.next_action_on&.to_fs(:long) %></td></tr><% end %></tbody></table></div>
