<!DOCTYPE html><html><head><title>CarePath</title><meta name="viewport" content="width=device-width,initial-scale=1"><%= csrf_meta_tags %><%= csp_meta_tag %><%= stylesheet_link_tag "application", "data-turbo-track": "reload" %><%= javascript_importmap_tags %></head>
<body><nav><strong><%= link_to "CarePath", root_path %></strong><div><% if current_user %><%= link_to "Patients", patients_path %> · <%= current_user.name %> · <%= button_to "Sign out", logout_path, method: :delete, form: {style:"display:inline"} %><% end %></div></nav><main class="container"><% if notice %><div class="notice"><%= notice %></div><% end %><% if alert %><div class="notice alert"><%= alert %></div><% end %><%= yield %></main></body></html>
